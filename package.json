{
  "name": "jenefa-company-workspace",
  "private": true,
  "workspaces": [
    "src",
    "uis/website",
    "uis/web"
  ],
  "scripts": {
    "start": "npm run start -w src --",
    "dev": "npm run dev -w src",
    "typecheck": "npm run typecheck -w src",
    "test": "npm run test -w src",
    "ops": "npm run ops -w src --",
    "build": "npm run build -w src",
    "preview": "npm run preview -w src",
    "exec": "npm exec -w src",
    "dev:website": "npm run dev -w website",
    "build:website": "npm run build -w website",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web"
  }
}
